# USNEE v2 Environment Variables
# Copy this file to .env and fill in your values

# PostHog Analytics (EU cloud, anonymous events only)
# Events: app_open, record_created, safety_opened — no substance names, doses, or notes
# Get from: https://eu.posthog.com/project/settings
VITE_POSTHOG_KEY=your-posthog-project-api-key
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Telegram WebApp
# These are typically set by Telegram automatically
# TELEGRAM_BOT_TOKEN=

# Backend sync (optional until the API is deployed)
# Without it the outbox stays local: nothing is sent, «Синхронизировано» not shown.
# VITE_API_BASE_URL=https://api.example.com
# Локальная проверка синхронизации: npm run dev:api + эти две строки
# VITE_API_BASE_URL=http://127.0.0.1:8788
# VITE_ALLOW_DEV_INITDATA=1
